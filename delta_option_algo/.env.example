# Delta Exchange India API credentials
# Generate these from your Delta Exchange India account -> API Management
DELTA_API_KEY=your_api_key_here
DELTA_API_SECRET=your_api_secret_here

# Environment: "production" or "testnet". ALWAYS start with testnet.
DELTA_ENV=testnet

# Safety switch. Must be explicitly set to "true" to send real orders.
# Anything else (or unset) runs the bot in dry-run/paper mode.
LIVE_TRADING=false
